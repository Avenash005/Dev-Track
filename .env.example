# ==============================================================================
# DevTrack AI — Global & Docker Compose Environment Configuration Template
# Copy this file to .env and configure for your local or containerized environment.
# Never commit real credentials or .env files to version control.
# ==============================================================================

# Application Environment & Ports
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost

# ------------------------------------------------------------------------------
# Database Credentials & Internal Networking
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devtrack_db

# Inside Docker Compose: Containers communicate using service DNS hostnames
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/devtrack_db?schema=public
MONGODB_URI=mongodb://mongodb:27017/devtrack_ai

# For Local Host Machine Development (outside Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devtrack_db?schema=public
# MONGODB_URI=mongodb://localhost:27017/devtrack_ai

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=super_secure_devtrack_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Ollama Local LLM Engine
# ------------------------------------------------------------------------------
# Inside Docker Compose:
OLLAMA_BASE_URL=http://ollama:11434
# For Local Host Machine Development (outside Docker):
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_DevTrackKey2026
RAZORPAY_KEY_SECRET=devtrack_razorpay_secret_test_2026
